# CivicBridge AI backend configuration. Copy to .env and fill in. Never commit .env.

# --- LLM provider: "gemini", "openai_compatible" (Ollama, Groq, OpenRouter...) or "none"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=60
# Total AI time allowed for one request. Keep it below the frontend's 120-second timeout.
REQUEST_DEADLINE_SECONDS=100
MAX_CONCURRENT_LLM_CALLS=8
# Cap on AI requests per day across all users, per server process. 0 means no cap.
LLM_DAILY_REQUEST_LIMIT=0
# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required when LLM_PROVIDER=openai_compatible, e.g. http://localhost:11434/v1 for Ollama
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- Embeddings: "sentence_transformers" (needs requirements-dev.txt) or "onnx" (lightweight)
EMBEDDING_BACKEND=onnx

# --- Retrieval
RETRIEVAL_TOP_K=6
# Candidates below this cosine similarity are discarded. Chosen from the sweep in evaluation/README.md.
SIMILARITY_THRESHOLD=0.45
MAX_CONTEXT_CHARS=6000

# --- Web
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=20
# Chat and verify requests per client per day. 0 means no limit.
RATE_LIMIT_PER_DAY=30
# Set true only behind a proxy you trust to set X-Forwarded-For (Render, for example).
TRUST_PROXY_HEADERS=false
# Number of proxies in front of the app that add to X-Forwarded-For. See docs/deployment.md.
TRUSTED_PROXY_HOPS=1
